{
  "name": "bili-danmu",
  "type": "module",
  "version": "0.1.0",
  "description": "哔哩哔哩直播弹幕交互式命令行工具",
  "author": "ovo-agentx <351813579+ovo-agentx@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://github.com/ovo-eihei/bili-danmu#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ovo-eihei/bili-danmu.git"
  },
  "bugs": {
    "url": "https://github.com/ovo-eihei/bili-danmu/issues"
  },
  "keywords": [
    "bilibili",
    "danmu",
    "danmaku",
    "live",
    "cli",
    "tui"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.11.2",
  "bin": {
